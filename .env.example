# Copy to .env and fill in. Never commit .env.

# Token Factory (inference + Sandboxes). Create at https://tokenfactory.nebius.com/project/api-keys
NEBIUS_API_KEY=
# Project ID from Token Factory > Project settings (read by contree-sdk and the Sandboxes REST API)
NEBIUS_PROJECT_ID=
# Same project ID, only needed if you use the contree CLI (`contree auth`)
NEBIUS_AI_PROJECT=

# Optional overrides
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
CONTREE_BASE_URL=https://api.tokenfactory.nebius.com/sandboxes

# Sandbox runner: contree | tools | local (local is dev only, never on the public server)
SANDBOX_RUNNER=local
# Image UUID of the prepared python + scientific-stack sandbox image (written by scripts/phase0_sandbox.py)
SANDBOX_IMAGE_UUID=

# Live-mode guards for the public demo
# Set to 1 on the public server: refuses SANDBOX_RUNNER=local
PUBLIC_DEPLOYMENT=0
LIVE_MODE_ENABLED=false
DAILY_BUDGET_USD=1.00
RUNS_PER_IP_PER_DAY=3

# Optional: Tavily bonus (cut first if behind)
TAVILY_API_KEY=

# Where raw datasets are stored. Keep this outside OneDrive/Dropbox if your repo lives there.
DATA_DIR=data/raw
